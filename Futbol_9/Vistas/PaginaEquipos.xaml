<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Futbol_9.Vistas.PaginaEquipos"
             Title="Gestion de Equipos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Label Text="Registrar Equipo (sin jugadores)" FontSize="20" FontAttributes="Bold" />

            <Picker x:Name="pkCampeonato" Title="Seleccione un campeonato" />

            <Entry x:Name="txtNombreEquipo" Placeholder="Nombre del equipo" />

            <Frame BackgroundColor="#EEF5FF" CornerRadius="10" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Delegado del equipo" FontAttributes="Bold" />
                    <Entry x:Name="txtDelegadoNombre" Placeholder="Nombre completo del delegado" />
                    <Entry x:Name="txtDelegadoDocumento" Placeholder="Documento" Keyboard="Text" />
                    <Entry x:Name="txtDelegadoTelefono" Placeholder="Teléfono" Keyboard="Telephone" />
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="10">
                <Button Text="Guardar equipo" Clicked="GuardarEquipo_Clicked" />
                <Button Text="Limpiar" Clicked="Limpiar_Clicked" />
                <Button Text="Actualizar" Clicked="Actualizar_Clicked" />
            </HorizontalStackLayout>

            <BoxView HeightRequest="1" Color="#DDDDDD" />

            <Label Text="Equipos registrados" FontAttributes="Bold" />

            <CollectionView x:Name="cvEquipos">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,6" Padding="10" HasShadow="True" CornerRadius="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" />
                                <Label Text="{Binding DelegadoNombre, StringFormat='Delegado: {0}'}" />
                                <Label Text="{Binding FechaFinInscripcion, StringFormat='Límite pago: {0:dd/MM/yyyy}'}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontSize="12"
               Text="Importante: La registración de jugadores se habilita cuando el plan esté totalmente pagado." />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>