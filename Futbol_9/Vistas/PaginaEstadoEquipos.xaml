<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:Futbol_9.Modelos"
             x:Class="Futbol_9.Vistas.PaginaEstadoEquipos"
             Title="Estado de equipos">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Resumen de planes por equipo" FontSize="20" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Actualizar" Clicked="Actualizar_Clicked" />
        </Grid>

        <CollectionView x:Name="cvResumen">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="modelos:ResumenPlan">
                    <Frame Margin="0,6" Padding="12" HasShadow="True" CornerRadius="12">
                        <Frame.Triggers>
                            <!--color de fondo-->
                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Pagado">
                                <Setter Property="BackgroundColor" Value="#E6F4EA" />
                                <!-- verde suave -->
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Pendiente">
                                <Setter Property="BackgroundColor" Value="#FFF8E1" />
                                <!-- amarillo suave -->
                            </DataTrigger>
                            <DataTrigger TargetType="Frame" Binding="{Binding Estado}" Value="Vencido">
                                <Setter Property="BackgroundColor" Value="#FFEBEE" />
                                <!-- rojo suave -->
                            </DataTrigger>
                        </Frame.Triggers>

                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding EquipoNombre}" FontSize="16" FontAttributes="Bold"/>
                                <Label Grid.Column="1" Text="{Binding Estado}" FontAttributes="Bold" />
                            </Grid>

                            <Label Text="{Binding LimitePago, StringFormat='Límite: {0:dd/MM/yyyy}'}" />
                            <HorizontalStackLayout>
                                <Label Text="{Binding Total,  StringFormat='Total: S/ {0:F2}'}" />
                                <Label Text="{Binding Pagado, StringFormat='  |  Pagado: S/ {0:F2}'}" />
                                <Label Text="{Binding Saldo,  StringFormat='  |  Saldo: S/ {0:F2}'}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>